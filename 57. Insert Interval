class Solution {
    public int[][] insert(int[][] intervals, int[] newInterval) {
        int n = intervals.length;
        if (n == 0) {
            return new int[][] { newInterval };
        }
        List<int[]> result = new ArrayList<>();

        // 1. Find the index of the first interval that could possibly overlap.
        // This is the first interval that ENDS >= newInterval's START.
        int leftIndex = binarySearchStart(intervals, newInterval[0]);

        // 2. Find the index of the last interval that could possibly overlap.
        // This is the last interval that STARTS <= newInterval's END.
        int rightIndex = binarySearchEnd(intervals, newInterval[1]);

        // 3. Add all intervals before the potential overlap zone
        // 0 -- leftIndex - 1
        for(int i=0;i<leftIndex;i++){
            result.add(intervals[i]);
        }

        // 4. Merge logic
        if(leftIndex<=rightIndex){
            int start = Math.min(intervals[leftIndex][0],newInterval[0]);
            int end = Math.max(intervals[rightIndex][1],newInterval[1]);
            result.add(new int[]{start,end});
        }
        else{
            result.add(newInterval);
        }

        // 5. Add all intervals after the overlap zone
        // rightIndex + 1 -- n
        for(int i=rightIndex+1;i<n;i++){
            result.add(intervals[i]);
        }

        return result.toArray(new int[result.size()][]);
    }

    public int binarySearchStart(int[][] intervals, int target){
        int left = 0, right = intervals.length-1;
        int leftIndex = intervals.length;
        while(left<=right){
            int mid = left + (right - left)/2;
            if(intervals[mid][1]>=target){
                leftIndex = mid;
                right = mid - 1;
            }
            else{
                left = mid + 1;
            }
        }
        return leftIndex;
    }

        public int binarySearchEnd(int[][] intervals, int target){
        int left = 0, right = intervals.length-1;
        int rightIndex = -1;
        while(left<=right){
            int mid = left + (right - left)/2;
            if(intervals[mid][0]<=target){
                rightIndex = mid;
                left = mid + 1;
            }
            else{
                right = mid - 1;
            }
        }
        return rightIndex;
    }
}

class Solution {
    public int[][] insert(int[][] intervals, int[] newInterval) {
        int n = intervals.length;
        if (n == 0) {
            return new int[][] { newInterval };
        }
        List<int[]> result = new ArrayList<>();

        int i=0;
        while(i<n && intervals[i][1]<newInterval[0]){
            result.add(intervals[i]);
            i++;
        }

        // 4. Merge logic
        while(i<n && intervals[i][0]<=newInterval[1]){
            newInterval[0] = Math.min(intervals[i][0],newInterval[0]);
            newInterval[1] = Math.max(intervals[i][1],newInterval[1]);
            i++;
        }
        
        result.add(newInterval);

        // 5. Add all intervals after the overlap zone
        // rightIndex + 1 -- n
        while(i<n){
            result.add(intervals[i]);
            i++;
        }

        return result.toArray(new int[result.size()][]);
    }
}
